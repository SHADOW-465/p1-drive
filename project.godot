; Engine configuration file.
config_version=5

[application]

config/name="P1 Drive"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Settings="*res://autoload/settings.gd"
FpsLog="*res://autoload/fps_log.gd"
Origin="*res://autoload/origin.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_local_constant=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=1
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
jolt_physics_3d/limits/world_boundary_shape_size=40000.0

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048

[shader_globals]

night_factor={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
